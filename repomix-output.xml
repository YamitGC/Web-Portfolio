/* ==========================================================================
   CORE PORTFOLIO STYLES
   ========================================================================== */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  background-color: var(--color-bg);
  color: var(--color-text-main);
  font-family: var(--font-main);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

ul {
  list-style: none;
}

a {
  color: inherit;
  text-decoration: none;
}

/* Layout Container */
.container {
  width: 90%;
  max-width: var(--max-width);
  margin: 0 auto;
}

.container--narrow {
  max-width: var(--max-width-narrow);
}

.section {
  padding: var(--space-xl) 0;
}

.section__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--space-lg);
  position: relative;
  display: inline-block;
}

.section__title::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 40px;
  height: 3px;
  background-color: var(--color-primary);
  border-radius: 2px;
}

.text-highlight {
  color: var(--color-primary);
}

.text-center {
  text-align: center;
}

/* Header & Nav */
.header {
  position: sticky;
  top: 0;
  /* Utiliza la variable de fondo convertida a transparente */
  background-color: var(--color-bg); 
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-border);
  z-index: 100;
  padding: 1rem 0;
  transition: background-color var(--transition-fast), border-color var(--transition-fast);
}

.header__container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: var(--space-md);
  padding-left: var(--space-md);
  border-left: 1px solid var(--color-border);
}

.logo {
  font-weight: 700;
  font-size: var(--fs-lg);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.logo__symbol {
  color: var(--color-primary);
  font-family: var(--font-code);
}

.nav__list {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.nav__link {
  color: var(--color-text-muted);
  transition: color var(--transition-fast);
  font-size: var(--fs-sm);
}

.nav__link:hover {
  color: var(--color-text-main);
}

.nav__link--cta {
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--color-primary);
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-primary);
}

.nav__link--cta:hover {
  background-color: var(--color-primary);
  color: #000;
}

/* Hero Section */
.hero {
  padding: 6rem 0 4rem;
}

.hero__content {
  max-width: 800px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: rgba(16, 185, 129, 0.08);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: var(--color-primary);
  padding: 0.3rem 0.8rem;
  border-radius: 50px;
  font-size: var(--fs-sm);
  margin-bottom: var(--space-md);
}

.badge__dot {
  width: 8px;
  height: 8px;
  background-color: var(--color-primary);
  border-radius: 50%;
}

.hero__title {
  font-size: var(--fs-3xl);
  line-height: 1.2;
  margin-bottom: var(--space-md);
  font-weight: 700;
}

.hero__subtitle {
  font-size: var(--fs-lg);
  color: var(--color-text-muted);
  margin-bottom: var(--space-lg);
}

.hero__actions {
  display: flex;
  gap: var(--space-sm);
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: var(--fs-sm);
  cursor: pointer;
  border: none;
  transition: all var(--transition-fast);
}

.btn--primary {
  background-color: var(--color-primary);
  color: #05130e;
}

.btn--primary:hover {
  background-color: var(--color-primary-hover);
}

.btn--secondary {
  background-color: transparent;
  color: var(--color-text-main);
  border: 1px solid var(--color-border);
}

.btn--secondary:hover {
  border-color: var(--color-text-main);
}

.btn--block {
  width: 100%;
}

.controls__btn {
  background: transparent;
  border: none;
  color: var(--color-text-muted);
  cursor: pointer;
  padding: 0.4rem;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.controls__btn:hover {
  color: var(--color-primary);
  background-color: rgba(16, 185, 129, 0.1);
}

.controls__btn--text {
  font-family: var(--font-code);
  font-weight: 600;
  font-size: var(--fs-sm);
}

/* Projects Section */
.projects__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-md);
}

.project-card {
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.project-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-primary);
}

.project-card__tag {
  font-size: var(--fs-sm);
  color: var(--color-accent);
  font-family: var(--font-code);
}

.project-card__title {
  font-size: var(--fs-xl);
  margin: var(--space-xs) 0 var(--space-sm);
}

.project-card__body p {
  color: var(--color-text-muted);
  font-size: var(--fs-sm);
  margin-bottom: var(--space-md);
}

.tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: var(--space-md);
}

.tech-stack__item {
  font-family: var(--font-code);
  font-size: 0.75rem;
  background-color: rgba(255, 255, 255, 0.05);
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-sm);
  color: var(--color-text-muted);
}

.project-card__link {
  color: var(--color-primary);
  font-weight: 600;
  font-size: var(--fs-sm);
}

/* Skills Section */
.skills__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: var(--space-md);
}

.skills__category {
  background-color: var(--color-bg-alt);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.skills__category-title {
  font-size: var(--fs-lg);
  margin-bottom: var(--space-sm);
  color: var(--color-primary);
}

.skills__list li {
  color: var(--color-text-muted);
  padding: 0.3rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

/* Contact Form */
.contact-form {
  background-color: var(--color-bg-alt);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  margin-top: var(--space-md);
}

.form-group {
  margin-bottom: var(--space-md);
}

.form-label {
  display: block;
  font-size: var(--fs-sm);
  margin-bottom: 0.4rem;
  color: var(--color-text-muted);
}

.form-input, .form-textarea {
  width: 100%;
  padding: 0.75rem;
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-main);
  font-family: inherit;
}

.form-input:focus, .form-textarea:focus {
  outline: none;
  border-color: var(--color-primary);
}

/* Footer */
.footer {
  border-top: 1px solid var(--color-border);
  padding: var(--space-md) 0;
  margin-top: var(--space-xl);
  color: var(--color-text-muted);
  font-size: var(--fs-sm);
}

.footer__container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer__socials {
  display: flex;
  gap: var(--space-sm);
}

.footer__social-link:hover {
  color: var(--color-primary);
}
